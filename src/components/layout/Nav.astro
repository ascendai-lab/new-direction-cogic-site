---
import type { Cta } from '@cms/types'
import { linkAttrs } from '@/lib/text'

interface Props {
  nav?: {
    logo?: { asset?: { url: string } }
    logoAlt?: string
    links?: { label: string; href: string }[]
    ctaButton?: Cta
    secondaryButton?: Cta
    mobileButton?: Cta
  }
}

const { nav } = Astro.props
const current = Astro.url.pathname.replace(/\/$/, '') || '/'
const logo = nav?.logo?.asset?.url ? `${nav.logo.asset.url}?w=400&auto=format` : '/img/logo.png'
---

<header class="site-header pad" id="site-header">
  <div class="topbar">
    <a href="/" aria-label="New Direction C.O.G.I.C home">
      <img class="logo" src={logo} alt={nav?.logoAlt ?? 'New Direction C.O.G.I.C'} width="760" height="183" />
    </a>
    <nav class="nav-inline" aria-label="Main">
      {nav?.links?.map((l) => <a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="header-actions" style="display:flex;gap:12px;align-items:center">
      {nav?.ctaButton && <a class="btn btn--donate btn--sm header-donate" href={nav.ctaButton.href}>{nav.ctaButton.label}</a>}
      {nav?.secondaryButton && (
        <a class="btn btn--navy btn--sm header-updates" href={nav.secondaryButton.href}>
          {nav.secondaryButton.label} <span class="arw" aria-hidden="true">&rarr;</span>
        </a>
      )}
      <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="nav" aria-label="Menu">
        <span class="bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
  <nav class="nav" id="nav" data-open="false" aria-label="Mobile">
    <ul>
      {nav?.links?.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      {nav?.secondaryButton && <li><a href={nav.secondaryButton.href}>{nav.secondaryButton.label}</a></li>}
      {nav?.mobileButton && (
        <li class="nav-cta"><a class="btn btn--primary" href={nav.mobileButton.href} {...linkAttrs(nav.mobileButton.href)}>{nav.mobileButton.label}</a></li>
      )}
    </ul>
  </nav>
</header>
