---
import type { Settings } from '@cms/types'

interface Props { settings?: Settings }
const { settings } = Astro.props
const year = new Date().getFullYear()
const socials = [['Facebook', settings?.facebook], ['Instagram', settings?.instagram], ['YouTube', settings?.youtube]].filter(([, href]) => href)
---

<footer class="site-footer">
  <div class="pad" style="max-width:var(--sheet);margin-inline:auto">
    <div class="footer-top">
      <div>
        <img class="footer-logo" src="/img/logo-white.png" alt="New Direction C.O.G.I.C" width="760" height="183" loading="lazy" />
        <p class="muted" style="margin-top:var(--space-4);font-size:15px;line-height:24px;max-width:38ch">{settings?.footerTagline}</p>
      </div>
      <div>
        <h2>Gatherings</h2>
        <ul>
          {settings?.gatherings?.map((g) => <li class="muted">{g.name}, {g.timeLabel}</li>)}
          <li><a href="/visit">Plan your visit</a></li>
        </ul>
      </div>
      <div>
        <h2>Connect</h2>
        <ul>
          {settings?.email && <li><span class="muted">Email:</span> <a href={`mailto:${settings.email}`}>{settings.email}</a></li>}
          <li><a href="/#updates">Get updates</a></li>
          <li><a href="/pastor">Meet our pastor</a></li>
          <li><a href="/give">Give</a></li>
          {socials.length > 0 && (
            <li class="socials">
              {socials.map(([label, href]) => (
                <a href={href} target="_blank" rel="noopener" aria-label={`New Direction C.O.G.I.C on ${label}`} title={label}>
                  {label === 'Facebook' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11.8" fill="#fff"/><path fill="#0866FF" d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg>
                  )}
                  {label === 'Instagram' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true"><defs><radialGradient id="ig-grad" cx="30%" cy="107%" r="150%"><stop offset="0" stop-color="#fdf497"/><stop offset=".05" stop-color="#fdf497"/><stop offset=".45" stop-color="#fd5949"/><stop offset=".6" stop-color="#d6249f"/><stop offset=".9" stop-color="#285AEB"/></radialGradient></defs><rect width="24" height="24" rx="6" fill="url(#ig-grad)"/><rect x="5" y="5" width="14" height="14" rx="4" fill="none" stroke="#fff" stroke-width="1.8"/><circle cx="12" cy="12" r="3.3" fill="none" stroke="#fff" stroke-width="1.8"/><circle cx="16.3" cy="7.7" r="1" fill="#fff"/></svg>
                  )}
                  {label === 'YouTube' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M9 8v8l7-4z"/><path fill="#FF0000" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                  )}
                </a>
              ))}
            </li>
          )}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {year} {settings?.copyrightName ?? 'New Direction C.O.G.I.C'}</span>
      <span>A congregation of the Church of God in Christ</span>
    </div>
    <p class="credit">Illustrative stock photography by Pavel Danilyuk on <a href="https://www.pexels.com/photo/smiling-people-clapping-hands-at-a-celebration-8815052/" rel="noopener">Pexels</a>.</p>
  </div>
</footer>
