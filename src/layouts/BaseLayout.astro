---
import '../styles/global.css'
import Nav from '@components/layout/Nav.astro'
import Footer from '@components/layout/Footer.astro'
import { getClient } from '@cms/client'
import { navQuery, siteSettingsQuery } from '@cms/queries'
import type { Settings } from '@cms/types'
import { indexingAllowed } from '@/lib/seo'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  noIndex?: boolean
}

const { title, description, ogImage, noIndex = false } = Astro.props

const isPreview = Astro.cookies.has('sanity-preview-secret')
const client = getClient(isPreview)

const [nav, settings] = await Promise.all([
  client.fetch(navQuery),
  client.fetch<Settings>(siteSettingsQuery),
])

const siteTitle = settings?.siteName ?? 'New Direction C.O.G.I.C'
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle
const pageDesc = description ?? settings?.defaultSeo?.metaDescription ?? ''
const pageImage = ogImage ?? settings?.defaultSeo?.ogImage?.asset?.url ?? new URL('/img/share.jpg', Astro.url).href
const gaId = settings?.googleAnalyticsId
// ponytail: stays hidden from search until ALLOW_INDEXING=true is set at launch, so previews never get indexed.
const hideFromSearch = noIndex || !indexingAllowed()
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href

// Street address is left out on purpose: they rent for now and have no Google listing until they own a building.
const home = new URL('/', Astro.site ?? Astro.url).href
const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
const vineland = { '@type': 'PostalAddress', addressLocality: 'Vineland', addressRegion: 'NJ', addressCountry: 'US' }
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Church',
      '@id': `${home}#church`,
      name: siteTitle,
      alternateName: 'New Direction Church of God in Christ',
      description: settings?.defaultSeo?.metaDescription,
      url: home,
      logo: new URL('/img/logo.png', home).href,
      image: new URL('/img/share.jpg', home).href,
      email: settings?.email,
      sameAs: [settings?.facebook, settings?.instagram, settings?.youtube, settings?.tiktok].filter(Boolean),
      areaServed: { '@type': 'City', name: 'Vineland, NJ' },
      memberOf: { '@type': 'Organization', name: 'Church of God in Christ', url: 'https://www.cogic.org' },
      employee: { '@type': 'Person', name: settings?.pastorName, jobTitle: 'Pastor', url: new URL('/pastor', home).href },
      event: settings?.gatherings?.map((g) => {
        const link = g.action?.href?.startsWith('http') ? g.action.href : undefined
        const online = g.key === 'bibleStudy' || g.key === 'prayerLine'
        return {
          '@type': 'Event',
          name: `${g.name} at ${siteTitle}`,
          description: `${g.name}, ${g.timeLabel} (Eastern). Everyone is welcome.`,
          eventAttendanceMode: `https://schema.org/${online ? 'Online' : 'Offline'}EventAttendanceMode`,
          location: online
            ? { '@type': 'VirtualLocation', url: link ?? new URL(`/${g.key === 'prayerLine' ? 'prayer-line' : 'bible-study'}`, home).href }
            : { '@type': 'Place', name: settings?.locationName ?? 'Vineland, NJ', address: vineland },
          eventSchedule: {
            '@type': 'Schedule',
            repeatFrequency: 'P1W',
            byDay: `https://schema.org/${days[g.weekday]}`,
            startTime: g.startTime,
            duration: `PT${g.durationMinutes}M`,
            scheduleTimezone: 'America/New_York',
          },
          isAccessibleForFree: true,
          organizer: { '@id': `${home}#church` },
        }
      }),
    },
    { '@type': 'WebSite', '@id': `${home}#website`, url: home, name: siteTitle, publisher: { '@id': `${home}#church` }, inLanguage: 'en-US' },
    { '@type': 'WebPage', url: canonical, name: pageTitle, description: pageDesc, isPartOf: { '@id': `${home}#website` } },
  ],
}

// Prefetch same-site pages on hover or pointer-down. Studio, API and text endpoints are left out.
const speculationRules = {
  prefetch: [{
    where: {
      and: [
        { href_matches: '/*' },
        { not: { href_matches: ['/studio', '/studio/*', '/api/*', '/*.txt', '/*.xml', '/*\\?*'] } },
        { not: { selector_matches: '[target=_blank], [rel~=nofollow], [download]' } },
      ],
    },
    eagerness: 'moderate',
  }],
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="text-scale" content="scale" />
    <title>{pageTitle}</title>
    {pageDesc && <meta name="description" content={pageDesc} />}
    {hideFromSearch && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0d2645" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={pageImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" href="/img/icon.png" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <link rel="preload" href="/fonts/google-sans-flex-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <script is:inline>
      // Cross-document view transitions: keep the header still instead of replaying its entrance.
      addEventListener('pagereveal', (e) => { if (e.viewTransition) document.documentElement.classList.add('vt-nav') })
    </script>
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="sheet">
      <Nav nav={nav} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>

    <Footer settings={settings} />
    <script>import '../scripts/site.ts'</script>

    {gaId && (
      <>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || []
          function gtag() { dataLayer.push(arguments) }
          gtag('js', new Date())
          gtag('config', gaId)
        </script>
        <script async fetchpriority="low" src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      </>
    )}
  </body>
</html>
