---
import BaseLayout from '@layouts/BaseLayout.astro'
import Sections from '@components/sections/Sections.astro'
import { getClient } from '@cms/client'
import { isPreview } from '@/lib/preview'
import { pageBySlugQuery, siteSettingsQuery } from '@cms/queries'
import { emphasize } from '@/lib/text'
import type { Settings } from '@cms/types'

const { slug } = Astro.params

const preview = isPreview(Astro.cookies)
if (preview) Astro.response.headers.set('Cache-Control', 'private, no-store')
const client = getClient(preview)
const [page, settings] = await Promise.all([
  client.fetch(pageBySlugQuery, { slug }),
  client.fetch<Settings>(siteSettingsQuery),
])

if (!page) return Astro.rewrite('/404')
---

<BaseLayout
  title={page.seo?.metaTitle ?? page.title}
  description={page.seo?.metaDescription}
  ogImage={page.seo?.ogImage?.asset?.url}
  noIndex={page.seo?.noIndex}
>
  <section class="hero page-hero pad center">
    {page.heroKicker && <p class="kicker rise">{page.heroKicker}</p>}
    <h1 class="display center rise" style="margin-inline:auto" set:html={emphasize(page.heroHeadline ?? page.title)} />
    {page.heroSubheadline && <p class="lead rise">{page.heroSubheadline}</p>}
  </section>

  <Sections sections={page.sections} settings={settings} />
</BaseLayout>
