---
import BaseLayout from '@layouts/BaseLayout.astro'
import Sections from '@components/sections/Sections.astro'
import { getClient } from '@cms/client'
import { homePageQuery, siteSettingsQuery } from '@cms/queries'
import { emphasize, linkAttrs } from '@/lib/text'
import type { Settings } from '@cms/types'

const client = getClient(Astro.cookies.has('sanity-preview-secret'))
const [page, settings] = await Promise.all([
  client.fetch(homePageQuery),
  client.fetch<Settings>(siteSettingsQuery),
])

const heroImage = page?.heroImage?.asset?.url ? `${page.heroImage.asset.url}?w=1900&auto=format` : '/img/hero-community.jpg'
const slots = JSON.stringify(settings?.gatherings?.map(({ name, weekday, startTime, durationMinutes }) => ({ name, weekday, startTime, durationMinutes })) ?? [])
const ribbon: string[] = page?.ribbon ?? []
---

<BaseLayout
  title={page?.seo?.metaTitle}
  description={page?.seo?.metaDescription}
  ogImage={page?.seo?.ogImage?.asset?.url}
  noIndex={page?.seo?.noIndex}
>
  <section class="hero pad">
    <div class="center">
      <p class="kicker rise">{page?.heroKicker}</p>
      <h1 class="display center rise" set:html={emphasize(page?.heroHeadline)} />
    </div>
    <figure class="hero-figure rise">
      <img src={heroImage} alt={page?.heroImageAlt ?? ''} width="1900" height="1266" fetchpriority="high" />
      <a class="next-chip" href="/visit" id="next-chip" data-gatherings={slots}>
        <span class="dot" aria-hidden="true"></span><span id="chip-text">{settings?.gatherings?.[0]?.timeLabel}</span>
      </a>
      <figcaption>
        {page?.heroCta && (
          <a class="btn btn--inverse" href={page.heroCta.href} {...linkAttrs(page.heroCta.href)}>
            {page.heroCta.label} <span class="arw" aria-hidden="true">&rarr;</span>
          </a>
        )}
        {page?.heroSecondaryCta && (
          <a class="btn btn--ghost-inverse hero-study" href={page.heroSecondaryCta.href} {...linkAttrs(page.heroSecondaryCta.href)}>{page.heroSecondaryCta.label}</a>
        )}
      </figcaption>
    </figure>
    <div style="height:clamp(28px,4vw,56px)"></div>
  </section>

  {ribbon.length > 0 && (
    <div class="ribbon" aria-hidden="true">
      <div class="ribbon-track">
        {[...ribbon, ...ribbon].map((item) => <span set:html={emphasize(item)} />)}
      </div>
    </div>
  )}

  <Sections sections={page?.sections} settings={settings} />
</BaseLayout>
